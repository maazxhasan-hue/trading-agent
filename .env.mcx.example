# Angel One SmartAPI MCX runtime settings — NEVER commit real values.
TRADING_BACKEND=angelone_mcx
MCX_BACKEND=angelone
MCX_MARKET_DATA_PROVIDER=angelone
MCX_SYMBOL_FAMILIES=ALL
MARKET_INTERVAL=5m
MAX_MARKETS_PER_SCAN=1000
MARKETS_PER_CYCLE=1000
SCAN_INTERVAL_SECONDS=300
MAX_LIVE_DATA_AGE_SECONDS=10
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_PRODUCT=CARRYFORWARD
ANGELONE_READONLY=true
ANGELONE_QUOTE_INTERVAL_SECONDS=0.12
# MCX uses LTP mode by default; set FULL only if broker access is verified.
ANGELONE_MARKET_DATA_MODE=LTP
ANGELONE_HISTORY_PREFETCH_LIMIT=10

# Live execution gates. Keep disabled until the operator has completed
# broker/account/static-IP checks and deliberately enables live mode.
LIVE_TRADING=false
LIVE_TRADING_ARM=
CLOUD_RUNTIME=false
LIVE_RUNTIME_APPROVED=false
LIVE_KILL_SWITCH=true

PAPER_STARTING_CAPITAL=100000
PAPER_TAKE_PROFIT_MULTIPLE=2.0
PAPER_MAX_HOLD_CYCLES=12
PAPER_SLIPPAGE_BPS=5
MIN_VALIDATED_AGENTS=3
MCX_MIN_CONFIDENCE=0.58
MCX_MIN_SCORE=0.60
MAX_POSITION_FRACTION=0.06
MAX_TOTAL_EXPOSURE_FRACTION=0.30
MAX_PORTFOLIO_DRAWDOWN_FRACTION=0.10
AGENT_LEARNING_HORIZON_SECONDS=300
AGENT_LEARNING_FILE=data/mcx_agent_learning.json
PAPER_STATE_FILE=data/mcx_paper_state.json
