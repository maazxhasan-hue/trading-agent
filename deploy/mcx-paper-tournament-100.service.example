[Unit]
Description=Isolated 1-hour MCX proxy paper tournament (₹100 virtual bankroll)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trading-agent
Environment=TRADING_BACKEND=mcx
Environment=MCX_BACKEND=paper
Environment=MCX_MARKET_DATA_PROVIDER=yahoo
Environment=MCX_SYMBOL_FAMILIES=GOLD,SILVER,CRUDEOIL,NATURALGAS,COPPER
Environment=MARKET_INTERVAL=5m
Environment=MARKETS_PER_CYCLE=5
Environment=SCAN_INTERVAL_SECONDS=300
Environment=LIVE_TRADING=false
Environment=LIVE_TRADING_ARM=
Environment=CLOUD_RUNTIME=false
Environment=LIVE_RUNTIME_APPROVED=false
Environment=LIVE_KILL_SWITCH=false
Environment=ANGELONE_READONLY=true
Environment=PAPER_STARTING_CAPITAL=100
Environment=PAPER_FRACTIONAL_UNITS=true
Environment=PAPER_FEE_BPS=2.5
Environment=PAPER_SLIPPAGE_BPS=5
Environment=MIN_VALIDATED_AGENTS=3
Environment=MAX_POSITION_FRACTION=0.06
Environment=MAX_TOTAL_EXPOSURE_FRACTION=0.30
Environment=MAX_DAILY_LOSS_FRACTION=0.03
Environment=AGENT_LEARNING_HORIZON_SECONDS=300
Environment=AGENT_LEARNING_FILE=data/mcx_tournament_100_learning.json
Environment=PAPER_STATE_FILE=data/mcx_tournament_100_state.json
Environment=TRADE_JOURNAL_FILE=data/mcx_tournament_100_journal.jsonl
ExecStart=/usr/bin/timeout --signal=TERM 1h /opt/trading-agent/.venv/bin/python -u /opt/trading-agent/mcx_agent.py
TimeoutStopSec=30
Restart=no
StandardOutput=append:/opt/trading-agent/logs/mcx-tournament-100.log
StandardError=append:/opt/trading-agent/logs/mcx-tournament-100.log

[Install]
WantedBy=multi-user.target
