FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV PORT=8080
ENV SCAN_INTERVAL_SECONDS=300
ENV AGENT_WORKSPACE_ROOT=/data/agent_workspaces
ENV AGENT_HEALTH_FILE=/data/logs/agent_runtime_health.json
ENV AGENT_LIFECYCLE_FILE=/data/agent_lifecycle.json
ENV AGENT_CALIBRATION_FILE=/data/agent_calibration.json
ENV POST_TRADE_FILE=/data/agent_health.json
ENV TRADING_LOG_FILE=/data/paper_trades.csv
CMD ["python","agent_supervisor.py"]

ENV GAMMA_PAGE_SIZE=100
ENV GAMMA_MIN_REQUEST_INTERVAL_SECONDS=2
ENV GAMMA_REQUEST_RETRIES=3
ENV GAMMA_BACKOFF_BASE_SECONDS=2
ENV GAMMA_MAX_RETRY_WAIT_SECONDS=60
ENV GAMMA_CACHE_MAX_AGE_SECONDS=900
ENV GAMMA_MARKET_CACHE_FILE=/data/gamma_markets_cache.json
