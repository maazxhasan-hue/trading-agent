# Angel One SmartAPI runtime settings — NEVER commit real values.
TRADING_BACKEND=angelone_nse
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_LOCAL_IP=127.0.0.1
ANGELONE_PRODUCT=INTRADAY
ANGELONE_READONLY=false
ANGELONE_QUOTE_INTERVAL_SECONDS=1.05
ANGELONE_HISTORY_PREFETCH_LIMIT=25

# Live execution remains OFF by default.
LIVE_TRADING=false
LIVE_TRADING_ARM=
CLOUD_RUNTIME=false
LIVE_RUNTIME_APPROVED=false
LIVE_KILL_SWITCH=false

# NSE market-data / research controls
NSE_MARKET_DATA_PROVIDER=angelone
NSE_SYMBOLS=
NSE_INTERVAL=5m
MAX_MARKETS_PER_SCAN=1000
NSE_RESEARCH_MARKETS_PER_CYCLE=25
MARKETS_PER_CYCLE=25
SCAN_INTERVAL_SECONDS=300
MAX_LIVE_DATA_AGE_SECONDS=10

# Paper/risk defaults
PAPER_STARTING_CAPITAL=100000
PAPER_TAKE_PROFIT_MULTIPLE=2.0
PAPER_MAX_HOLD_CYCLES=12
PAPER_SLIPPAGE_BPS=5
MIN_VALIDATED_AGENTS=3
NSE_MIN_CONFIDENCE=0.58
NSE_MIN_SCORE=0.60
MAX_POSITION_FRACTION=0.06
MAX_TOTAL_EXPOSURE_FRACTION=0.30
MAX_DAILY_LOSS_FRACTION=0.03
MAX_PORTFOLIO_DRAWDOWN_FRACTION=0.10
AGENT_LEARNING_HORIZON_SECONDS=300
AGENT_LEARNING_FILE=/data/nse_agent_learning.json

# Legacy Zerodha settings are retained only for the old backend.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
ZERODHA_PRODUCT=MIS

# Safety: Yahoo is not an authorised live feed. Angel One is required for
# authorised NSE live execution.
