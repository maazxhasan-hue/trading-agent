# Angel One SmartAPI credentials (keep secrets only in the VM environment file)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_CLIENT_LOCAL_IP=

# Safe defaults: read-only broker access; never enable live orders from this example
TRADING_BACKEND=angelone_nse
LIVE_TRADING=false
LIVE_TRADING_ARM=
CLOUD_RUNTIME=false
LIVE_RUNTIME_APPROVED=false
ANGELONE_READONLY=true

# Zero-cost Yahoo data is research/paper-only; not a live execution quote source.
NSE_MARKET_DATA_PROVIDER=yahoo
NSE_SYMBOLS=RELIANCE,INFY,HDFCBANK,TCS,ICICIBANK,SBIN,LT,AXISBANK,ITC,BHARTIARTL
NSE_INTERVAL=5m
NSE_RESEARCH_MARKETS_PER_CYCLE=10
MAX_MARKETS_PER_SCAN=100
SCAN_INTERVAL_SECONDS=300
MAX_LIVE_DATA_AGE_SECONDS=10
PAPER_STARTING_CAPITAL=100
PAPER_TAKE_PROFIT_MULTIPLE=2.0
PAPER_MAX_HOLD_CYCLES=12
PAPER_SLIPPAGE_BPS=5
MIN_VALIDATED_AGENTS=3
NSE_MIN_CONFIDENCE=0.58
NSE_MIN_SCORE=0.60
MAX_POSITION_FRACTION=0.06
MAX_TOTAL_EXPOSURE_FRACTION=0.30
MAX_DAILY_LOSS_FRACTION=0.03
MAX_PORTFOLIO_DRAWDOWN_FRACTION=0.10
LEARNING_MOVE_MODE=relative
LEARNING_MIN_MOVE_PCT=0.001
AGENT_LEARNING_HORIZON_SECONDS=300
AGENT_LEARNING_FILE=/data/nse_agent_learning.json

# Before live trading: validate Angel One IP registration, broker funds/margin,
# supported instrument master/lot sizes, quote freshness, protective exits,
# durable risk state, and broker reconciliation. Keep LIVE_TRADING=false until
# all live-readiness checks pass and the operator separately approves live mode.
