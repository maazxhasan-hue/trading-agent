# Zerodha credentials (execution/account access)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Keep live execution disabled
LIVE_TRADING=false
LIVE_TRADING_ARM=
CLOUD_RUNTIME=false
LIVE_RUNTIME_APPROVED=false

# Zero-cost NSE research/paper data
NSE_MARKET_DATA_PROVIDER=yahoo
NSE_SYMBOLS=RELIANCE,INFY,HDFCBANK,TCS,ICICIBANK,SBIN,LT,AXISBANK,ITC,BHARTIARTL
NSE_INTERVAL=5m
NSE_RESEARCH_MARKETS_PER_CYCLE=10
MAX_MARKETS_PER_SCAN=100
SCAN_INTERVAL_SECONDS=300
MAX_LIVE_DATA_AGE_SECONDS=10
MIN_VALIDATED_AGENTS=3
NSE_MIN_CONFIDENCE=0.58
NSE_MIN_SCORE=0.60
MAX_POSITION_FRACTION=0.06
MAX_DAILY_LOSS_FRACTION=0.03
MAX_PORTFOLIO_DRAWDOWN_FRACTION=0.10
ZERODHA_PRODUCT=MIS
LEARNING_MOVE_MODE=relative
LEARNING_MIN_MOVE_PCT=0.001
AGENT_LEARNING_HORIZON_SECONDS=300
AGENT_LEARNING_FILE=/data/nse_agent_learning.json

# The free Yahoo provider is research/paper-only.
# Use a Zerodha data-enabled provider for any authorised live strategy.
