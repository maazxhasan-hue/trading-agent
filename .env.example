# Copy to your runtime environment; NEVER commit real values.
# PAPER / LOCAL SAFE DEFAULTS
LIVE_TRADING=false
LIVE_TRADING_ARM=
CLOUD_RUNTIME=false
LIVE_RUNTIME_APPROVED=false

CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
PK=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
POLYMARKET_TICK_SIZE=0.01

# Gamma market-feed hardening
GAMMA_PAGE_SIZE=100
GAMMA_MIN_REQUEST_INTERVAL_SECONDS=3.0
GAMMA_REQUEST_RETRIES=2
GAMMA_BACKOFF_BASE_SECONDS=2
GAMMA_MAX_RETRY_WAIT_SECONDS=60
GAMMA_RATE_LIMIT_COOLDOWN_SECONDS=900
GAMMA_MARKET_CACHE_FILE=/data/gamma_markets_cache.json
GAMMA_CACHE_MAX_AGE_SECONDS=900

# Out-of-sample fair-value validation gate
VALIDATION_MIN_SAMPLES=30
VALIDATION_MIN_ACCURACY=0.55
VALIDATION_MAX_BRIER=0.25
VALIDATION_MIN_MOVE=0.005
VALIDATION_LOOKBACK=60

# Online forecast learning (paper-mode observation only)
AGENT_LEARNING_FILE=/data/agent_learning.json
AGENT_LEARNING_HORIZON_SECONDS=300
LEARNING_MIN_MOVE=0.005

# Learning qualification gate
LEARNING_MIN_SAMPLES=30
LEARNING_MIN_ACCURACY=0.55
LEARNING_MAX_BRIER=0.25
MIN_VALIDATED_AGENTS=3
LIVE_PORTFOLIO_FILE=/data/live_portfolio.json
